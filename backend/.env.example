# Local desktop / development: SQLite file next to the Prisma schema
DATABASE_URL="file:./dev.db"

# Cloud deployment: a Postgres connection string instead, e.g.
# DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"
# The build script (scripts/prepare-db.js) switches the Prisma provider
# to postgresql automatically when DATABASE_URL is a postgres:// URL.

# Credentials for the admin account seeded on an empty database
# (defaults to admin / 123456 when unset).
# ADMIN_USERNAME="admin"
# ADMIN_PASSWORD="change-me"
